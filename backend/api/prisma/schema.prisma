generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Data Models

model User {
  id             String          @id
  email          String          @unique
  login          String?         @unique
  role           UserRole        @default(USER)
  profile        Profile? /// regroupe les attributs facultatifs
  channels       User_Channel[] // explicit N-N relation via User_Channel
  chats          Chat[] // implicit N-N relation: a User_Chat model/table will be inferred/generated
  notifs         Notification[]
  posts          Post[]
  messages       Message[]
  projectMessages ProjectMessage[]
  reactions      Reaction[] /// reactions to posts
  interests      User_Interest[]
  friendsReqSent FriendRequest[] @relation(name: "sent")
  friendsReqRecv FriendRequest[] @relation(name: "received")
  players        Player[]
  name           String?
  bannedAt         DateTime?
  moderationReason String?
  emailVerified  Boolean         @default(false)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  accounts       Account[]
  files          FileAsset[]
  dataRequests      DataRequest[]
  interestRequests InterestRequest[]
  blockedUsers      BlockedUser[] @relation("blockedBy")
  blockedByUsers    BlockedUser[] @relation("blockedUsers")

  @@map("user")
}

model Profile {
  id        Int             @id @default(autoincrement())
  firstname String?
  lastname  String?
  pseudo    String?
  birthdate DateTime?
  avatarUri String?
  level     Float?          @default(0)
  bio       String?
  userId    String          @unique
  user      User            @relation(fields: [userId], references: [id])
  socials   ProfileSocial[]
}

model ProfileSocial {
  id        Int     @id @default(autoincrement())
  platform  String
  label     String
  url       String
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model FriendRequest {
  id         Int                 @id @default(autoincrement())
  senderId   String
  receiverId String
  pairKey    String              @unique
  sender     User                @relation(name: "sent", fields: [senderId], references: [id])
  receiver   User                @relation(name: "received", fields: [receiverId], references: [id])
  status     FriendRequestStatus
  CreatedAt  DateTime            @default(now())
  UpdatedAt  DateTime            @updatedAt
}

model BlockedUser {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("blockedBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blockedUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// Structure hierachique des centres d'interets

model Interest {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  color           String? // couleur d'affichage d'un interet et de ses enfants 
  imageUri        String?
  parentId        Int? /// catégorie parente (interet de niveau supérieur)
  parent          Interest?       @relation(name: "tree", fields: [parentId], references: [id])
  children        Interest[]      @relation(name: "tree")
  channel         Channel?        @relation(name: "mainInterest")
  //relatedChannels    Channel[]        /// "tagged" channels  // supprimé
  interestedUsers User_Interest[]
  relatedPosts    Post[] // tagged posts (pour utilisation future) (n-n implicit relation)
}

model InterestRequest {
  id             Int                   @id @default(autoincrement())
  requesterId    String
  name           String
  normalizedName String
  description    String
  status         InterestRequestStatus @default(pending)
  requestedAt    DateTime              @default(now())
  reviewedAt     DateTime?
  updatedAt      DateTime              @updatedAt
  requester      User                  @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, normalizedName])
  @@index([status, requestedAt])
}

model User_Interest {
  userId      String
  interestId  Int
  user        User          @relation(fields: [userId], references: [id])
  interest    Interest      @relation(fields: [interestId], references: [id])
  interestLvl InterestLevel @default(High)

  //skillLvl      SkillLevel     @default(Confirmed)   //supprimé
  @@id([userId, interestId])
}

model Channel {
  id          Int            @id @default(autoincrement())
  interestId  Int            @unique
  description String?
  interest    Interest       @relation(name: "mainInterest", fields: [interestId], references: [id])
  posts       Post[]
  users       User_Channel[]
  //imageUri    String?               // déplacé dans Interest
  //title       String      @unique   // supprimé  (redondant avec Interest.name)
  //tags        Interest[]            // supprimé
}

model Project {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  color       String
  description String
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    ProjectMessage[]

  @@index([sortOrder])
}

model ProjectMessage {
  id        Int      @id @default(autoincrement())
  projectId Int
  senderId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([senderId, createdAt])
}

model User_Channel {
  userId     String
  channelId  Int
  user       User     @relation(fields: [userId], references: [id])
  channel    Channel  @relation(fields: [channelId], references: [id])
  joinedAt   DateTime @default(now())
  isFavorite Boolean

  @@id([userId, channelId])
}

model Post {
  id          Int            @id @default(autoincrement())
  createdAt   DateTime       @default(now())
  content     String
  type        PostType       @default(Normal)
  parentId    Int? // fait reference à un autre post (réponse ou commentaire de)
  parent      Post?          @relation(name: "tree", fields: [parentId], references: [id])
  children    Post[]         @relation(name: "tree")
  authorId    String
  channelId   Int
  author      User           @relation(fields: [authorId], references: [id])
  channel     Channel        @relation(fields: [channelId], references: [id])
  reactions   Reaction[]
  attachments Attachment[]
  tags        Interest[] // Pour utilisation future (n-n implicit relation)
  notifs      Notification[]
}

model Reaction {
  id     Int    @id @default(autoincrement())
  emoji  String
  userId String
  postId Int
  user   User   @relation(fields: [userId], references: [id])
  post   Post   @relation(fields: [postId], references: [id])
}

model FileAsset {
  id             Int            @id @default(autoincrement())
  ownerId        String
  storageKey     String         @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  category       FileCategory
  attachmentType AttachmentType
  status         FileStatus     @default(uploaded)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  owner          User           @relation(fields: [ownerId], references: [id])
  attachments    Attachment[]

  @@index([ownerId])
}

model Attachment {
  id        Int            @id @default(autoincrement())
  type      AttachmentType
  fileId    Int
  postId    Int?
  messageId Int?
  file      FileAsset      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  post      Post?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  message   Message?       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([postId])
  @@index([messageId])
}

model Chat {
  id       Int       @id @default(autoincrement())
  name     String
  type     ChatType
  messages Message[]
  users    User[]
}

model Message {
  id        Int            @id @default(autoincrement())
  createdAt DateTime       @default(now())
  content   String
  type      MessageType    @default(Normal)
  senderId  String
  chatId    Int
  sender    User           @relation(fields: [senderId], references: [id])
  chat      Chat           @relation(fields: [chatId], references: [id])
  notifs    Notification[]
  attachments Attachment[]
}

model Notification {
  id        Int       @id @default(autoincrement())
  type      NotifType // chat message / post / response
  userId    String
  postId    Int?
  messageId Int?
  user      User      @relation(fields: [userId], references: [id])
  post      Post?     @relation(fields: [postId], references: [id])
  message   Message?  @relation(fields: [messageId], references: [id])
}

model DataRequest {
  id                    Int               @id @default(autoincrement())
  userId                String
  type                  DataRequestType
  status                DataRequestStatus @default(pending)
  confirmationTokenHash String?           @unique
  confirmationExpiresAt DateTime?
  exportStorageKey      String?
  exportMimeType        String?
  exportSizeBytes       Int?
  requestedAt           DateTime          @default(now())
  confirmedAt           DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type, status])
}

// Jeux

model Game {
  id         Int           @id @default(autoincrement())
  name       String
  imageUri   String
  realtime   Boolean
  maxPlayers Int
  sessions   GameSession[]
}

model GameSession {
  id        Int       @id @default(autoincrement())
  gameId    Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  game      Game      @relation(fields: [gameId], references: [id])
  state     GameState
  players   Player[]
}

model Player {
  id        Int         @id @default(autoincrement())
  userId    String
  sessionId Int
  user      User        @relation(fields: [userId], references: [id])
  session   GameSession @relation(fields: [sessionId], references: [id])
  score     Int
}

// Enums

enum UserRole {
  GUEST
  USER
  ADMIN
}

enum FriendRequestStatus {
  Pending
  Accepted
  Rejected
}

enum InterestLevel {
  Moderate
  High
  VeryHigh
}

enum AttachmentType {
  image
  pdf
  text_document
  archive
  word_document
  open_document
}

enum FileCategory {
  image
  document
  archive
  other
}

enum FileStatus {
  uploaded
  attached
  deleted
}

enum DataRequestType {
  export
  deletion
}

enum DataRequestStatus {
  pending
  confirmed
  processing
  completed
  cancelled
  expired
}

enum InterestRequestStatus {
  pending
  approved
  rejected
}

enum ChatType {
  Interest
  Group
  Private
}

enum MessageType {
  Normal
  Auto
}

enum PostType {
  Normal
  Auto
}

enum GameState {
  Created
  Playing
  Ended
}

enum NotifType {
  ChannelPost
  PostResponse
  ChatMessage
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
